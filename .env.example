# For Vercel: configure these values in Project Settings > Environment Variables.
# Use a Gemini project on the Free Tier, with no paid billing enabled.
# Optional: leave blank and enter a personal Gemini key in the website for one session.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
PORT=4318


